# Copy to .env. Values are literal: do not add quotes or shell expansion. Do not commit .env.
# Generate a random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Copy the SAME token into the extension's email bridge settings.
BOT_BRIDGE_TOKEN=

# All email recipients are configured here, never supplied by browser requests.
# SMTP_PASSWORD usually means your provider's SMTP authorization/app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# For STARTTLS use SMTP_SECURITY=starttls and usually SMTP_PORT=587.
# Optional for local host only; Docker always stores data at /app/data.
# BOT_DATA_DIR=E:\your-private-data\dead-mom-sharing

# Ubuntu remote desktop password (8+ characters, classic VNC uses first 8).
BOT_VNC_PASSWORD=
